# Ban cho Hugging Face Spaces: co du RAM chay SigLIP nen KHONG can goi API tra tien.
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Spaces chay bang user 1000, cache phai ghi duoc
RUN useradd -m -u 1000 user
USER user
ENV HOME=/home/user PATH=/home/user/.local/bin:$PATH \
    HF_HOME=/home/user/.cache/huggingface

WORKDIR /home/user/app
COPY --chown=user requirements-local.txt requirements.txt ./
RUN pip install --no-cache-dir --user -r requirements-local.txt

COPY --chown=user *.py index.html kis-viewer.html media-index.json ./

# Nap san SigLIP luc build de lan chay dau khong phai cho tai model
RUN python3 -c "import scorers; scorers.get(scorers.SIGLIP); print('siglip da nap san')"

ENV HOST=0.0.0.0 \
    PORT=7860 \
    KIS_BACKENDS=siglip,hybrid,api \
    KIS_FETCH=1 \
    KIS_VIDEO_DIR=/home/user/videos \
    KIS_VIDEO_CACHE_MB=8000

EXPOSE 7860
CMD ["python3", "serve.py"]
