# Chep file nay thanh .env roi dien khoa cua ban vao.
# .env da nam trong .gitignore -- KHONG BAO GIO commit no.
#
#   cp .env.example .env
#   python3 api_backend.py        # kiem tra cau hinh

# Chon MOT trong hai:
#
# OpenAI truc tiep -- dung gpt-4o-mini cho re (nhin duoc anh, ~$0.00008/frame)
KIS_API_BASE=https://api.openai.com/v1
#
# Agent Router (agentrouter.org), noi bang chuan OpenAI
# KIS_API_BASE=https://agentrouter.org/v1

# Khoa lay tu Console > API Keys. Day la bi mat.
KIS_API_KEY=

# Model phai NHIN DUOC ANH (vision).
# CANH BAO: model "nhe" KHONG re hon cho anh. gpt-4o-mini nhan token anh len ~33
# lan de bu gia token re, nen cuoi cung dat hon ca gpt-4o. So do that voi mot
# frame 512px, detail=low (xem bang trong README):
#   gpt-4o         117 token   $0.00034/frame   cham dung (90)   <- chon cai nay
#   gpt-4o-mini   2865 token   $0.00043/frame   cham dung (90)
#   gpt-4.1-mini   265 token   $0.00011/frame   cham SAI  (30)
#   gpt-4.1-nano   386 token   $0.00004/frame   cham SAI  (10)
# Kiem tra truoc khi cham that:
#   python3 deploy/test_api.py --list
#   python3 deploy/test_api.py
KIS_API_MODEL=gpt-4o

# --- Agent Router: KHONG DUNG DUOC cho cong cu nay ---
# Router chi cho phep mot so client ho ho tro chinh thuc; script tu viet bi tu
# choi 401 "unauthorized client detected" o MOI endpoint, ke ca GET /models.
# Da thu: khoa moi, prompt tieng Anh, SDK openai chinh thuc, User-Agent chuan --
# deu 401. Day la chinh sach cua ho, khong phai loi cau hinh.
# Giu lai de tham khao; bo dau # neu ho mo quyen cho ban.
# KIS_AR_BASE=https://agentrouter.org/v1
# KIS_AR_KEY=
# KIS_AR_MODEL=gpt-5.6-sol
