# Chep file nay thanh .env roi dien khoa cua ban vao.
# .env da nam trong .gitignore -- KHONG BAO GIO commit no.
#
#   cp .env.example .env
#   python3 api_backend.py        # kiem tra cau hinh

# Agent Router (agentrouter.org) noi duoc bang chuan OpenAI.
# Xac nhan lai duong dan chinh xac o tab Docs trong console cua ban.
KIS_API_BASE=https://agentrouter.org/v1

# Khoa lay tu Console > API Keys. Day la bi mat.
KIS_API_KEY=

# Model phai nhin duoc anh (vision). Theo bang gia cua ban:
#   claude-opus-5     Prompt $2 / Completion $10 per 1M  <- re nhat, chon cai nay
#   claude-opus-4-8   Prompt $3 / Completion $15 per 1M
#   gpt-5.6-sol       Prompt $4 / Completion $20 per 1M
KIS_API_MODEL=claude-opus-5
