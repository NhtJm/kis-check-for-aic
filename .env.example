# Chep file nay thanh .env roi dien khoa cua ban vao.
# .env da nam trong .gitignore -- KHONG BAO GIO commit no.
#
#   cp .env.example .env
#   python3 api_backend.py        # kiem tra cau hinh

# Chon MOT trong hai:
#
# OpenAI truc tiep -- dung gpt-4o-mini cho re (nhin duoc anh, ~$0.00008/frame)
KIS_API_BASE=https://api.openai.com/v1
#
# Agent Router (agentrouter.org), noi bang chuan OpenAI
# KIS_API_BASE=https://agentrouter.org/v1

# Khoa lay tu Console > API Keys. Day la bi mat.
KIS_API_KEY=

# Model phai NHIN DUOC ANH (vision). Uu tien loai nhe cho re:
#   gpt-4o-mini    $0.15 / $0.60 per 1M   <- re nhat, du dung
#   gpt-4.1-nano   $0.10 / $0.40 per 1M
#   gpt-4o         $2.50 / $10.00 per 1M  <- chi khi can chinh xac cao
# Kiem tra truoc khi cham that:
#   python3 deploy/test_api.py --list
#   python3 deploy/test_api.py
KIS_API_MODEL=gpt-4o-mini
